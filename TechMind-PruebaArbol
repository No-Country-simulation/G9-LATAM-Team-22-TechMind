    "# ============================================================\n",
    "# PASO 38 - TF-IDF HÍBRIDO + EMBEDDINGS\n",
    "# ============================================================\n",
    "\n",
    "import numpy as np\n",
    "from scipy.sparse import csr_matrix, hstack\n",
    "\n",
    "from sklearn.svm import LinearSVC\n",
    "from sklearn.metrics import (\n",
    "    accuracy_score,\n",
    "    f1_score,\n",
    "    classification_report\n",
    ")\n",
    "\n",
    "print(\"===== PASO 38 =====\")\n",
