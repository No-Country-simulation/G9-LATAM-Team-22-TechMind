    "    # Métricas\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    accuracy = accuracy_score(\n",
    "        y_test_text,\n",
    "        pred_hibrido_embeddings\n",
    "    )\n",
    "\n",
    "    f1 = f1_score(\n",
    "        y_test_text,\n",
    "        pred_hibrido_embeddings,\n",
    "        average=\"macro\"\n",
    "    )\n",
    "\n",
    "\n",
    "    resultados_embeddings_hibridos.append({\n",
    "        \"peso_embeddings\": peso,\n",
    "        \"accuracy\": accuracy,\n",
    "        \"f1_macro\": f1\n",
    "    })\n",
    "\n",
    "\n",
    "    print(\n",
    "        f\"Accuracy: {accuracy:.4f} | \"\n",
    "        f\"F1 Macro: {f1:.4f}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. Comparación\n",
    "# ============================================================\n",
    "\n",
    "resultados_embeddings_hibridos = (\n",
    "    pd.DataFrame(\n",
    "        resultados_embeddings_hibridos\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n===== COMPARACIÓN =====\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    resultados_embeddings_hibridos\n",
    "    .sort_values(\n",
    "        \"f1_macro\",\n",
    "        ascending=False\n",
    "    )\n",
    "    .to_string(index=False)\n",
    ")\n",
    "\n",
