    "\n",
    "    X_train_combinado = hstack([\n",
    "        X_train_hybrid,\n",
    "        X_train_emb_sparse * peso\n",
    "    ]).tocsr()\n",
    "\n",
    "    X_test_combinado = hstack([\n",
